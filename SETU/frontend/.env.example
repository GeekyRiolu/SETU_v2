# Base URL of the SETU REST API (SETU/interfaces/rest/app.py).
# The frontend calls POST /translate and GET /languages here.
# SETU runs fully offline on your own machine — start the API with:
#   cd SETU && uvicorn interfaces.rest.app:app --host 0.0.0.0 --port 8000
NEXT_PUBLIC_SETU_API=http://localhost:8000
